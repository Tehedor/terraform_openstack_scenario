name        = "example_security_group"
description = "An example security group for demonstration purposes"

additional_rules = [
  {
    direction        = "ingress"
    ethertype        = "IPv4"
    protocol         = "tcp"
    remote_ip_prefix = "0.0.0.0/0"
  },
  {
    direction        = "egress"
    ethertype        = "IPv4"
    protocol         = "tcp"
    remote_ip_prefix = "0.0.0.0/0"
  },
  {
    direction        = "ingress"
    ethertype        = "IPv4"
    protocol         = "udp"
    remote_ip_prefix = "0.0.0.0/0"
  },
  {
    direction        = "egress"
    ethertype        = "IPv4"
    protocol         = "udp"
    remote_ip_prefix = "0.0.0.0/0"
  }
]